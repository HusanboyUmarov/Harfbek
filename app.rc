#include <windows.h>
#include <winver.h>
#include "src/resource.h"

// Dastur ikonkasi. Eng kichik ID'li ICON resursi .exe ikonkasi bo'ladi.
IDI_APPICON ICON "assets/icon.ico"

// Manifest (Common Controls v6 + DPI): CREATEPROCESS_MANIFEST_RESOURCE_ID = 1, RT_MANIFEST = 24
1 24 "app.manifest"

// Versiya ma'lumoti (Explorer: Xossalar -> Tafsilotlar). Matnlar ASCII - rc
// kodlashiga bog'liq bo'lmasligi uchun (MSVC rc va MinGW windres ikkalasida bir xil).
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Husanboy Umarov (ascoder)"
            VALUE "FileDescription",  "Harfbek - Uzbek special letters"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Harfbek"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Husanboy Umarov (ascoder)"
            VALUE "OriginalFilename", "harfbek.exe"
            VALUE "ProductName",      "Harfbek"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

// Til tanlash dialogi (matnlar ish vaqtida qo'yiladi - shuning uchun bu yerda bo'sh)
IDD_LANG DIALOGEX 0, 0, 200, 94
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Language"
FONT 9, "Segoe UI"
BEGIN
    LTEXT      "", IDC_LANG_PROMPT, 12, 10, 176, 18
    PUSHBUTTON "", IDC_LANG_UZ,     12, 34, 176, 15
    PUSHBUTTON "", IDC_LANG_RU,     12, 53, 176, 15
    PUSHBUTTON "", IDC_LANG_EN,     12, 72, 176, 15
END

// Litsenziya / ogohlantirish dialogi (matn ish vaqtida joriy tilda qo'yiladi)
IDD_LICENSE DIALOGEX 0, 0, 300, 190
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "License"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT   IDC_LIC_TEXT, 14, 12, 272, 140,
               ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "", IDOK,          120, 162, 76, 16
    PUSHBUTTON "", IDC_LIC_GITHUB,   210, 162, 76, 16
END
