#include <windows.h>
#include <winver.h>
#include "src/resource.h"

// Dastur ikonkasi. Eng kichik ID'li ICON resursi .exe ikonkasi bo'ladi.
IDI_APPICON ICON "assets/icon.ico"

// Manifest (Common Controls v6 + DPI): CREATEPROCESS_MANIFEST_RESOURCE_ID = 1, RT_MANIFEST = 24
1 24 "app.manifest"

// Versiya ma'lumoti (Explorer: Xossalar -> Tafsilotlar). Matnlar ASCII - rc
// kodlashiga bog'liq bo'lmasligi uchun (MSVC rc va MinGW windres ikkalasida bir xil).
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Husanboy Umarov (ascoder)"
            VALUE "FileDescription",  "Harfbek - Uzbek special letters"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Harfbek"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Husanboy Umarov (ascoder)"
            VALUE "OriginalFilename", "harfbek.exe"
            VALUE "ProductName",      "Harfbek"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

// Til tanlash dialogi (matnlar ish vaqtida qo'yiladi - shuning uchun bu yerda bo'sh)
IDD_LANG DIALOGEX 0, 0, 200, 94
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Language"
FONT 9, "Segoe UI"
BEGIN
    LTEXT      "", IDC_LANG_PROMPT, 12, 10, 176, 18
    PUSHBUTTON "", IDC_LANG_UZ,     12, 34, 176, 15
    PUSHBUTTON "", IDC_LANG_RU,     12, 53, 176, 15
    PUSHBUTTON "", IDC_LANG_EN,     12, 72, 176, 15
END

// Sozlamalar dialogi: tab control + pastda umumiy [Saqlash] [Bekor qilish].
// Matnlar ish vaqtida joriy tilda qo'yiladi. Tab sahifalari quyida alohida
// child dialoglar (DS_CONTROL | WS_CHILD); ular kod orqali tab ustiga joylanadi.
IDD_SETTINGS DIALOGEX 0, 0, 300, 212
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI"
BEGIN
    CONTROL       "", IDC_SET_TAB, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS, 7, 7, 286, 172
    DEFPUSHBUTTON "", IDOK,     181, 188, 54, 16
    PUSHBUTTON    "", IDCANCEL, 239, 188, 54, 16
END

// Tab "Umumiy"
IDD_SET_GENERAL DIALOGEX 0, 0, 272, 148
STYLE DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    LTEXT      "", IDC_SET_LANG_LBL, 10, 14, 90, 10
    COMBOBOX   IDC_SET_LANG, 104, 12, 150, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT      "", IDC_SET_APO_LBL,  10, 38, 90, 10
    COMBOBOX   IDC_SET_APO,  104, 36, 150, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "", IDC_SET_STARTUP, 10, 62, 252, 12
    AUTOCHECKBOX "", IDC_SET_NOTIFY,  10, 80, 252, 12
END

// Tab "Rejim": ikki radio (har biri o'z guruhida - tanlovni kod boshqaradi)
IDD_SET_MODE DIALOGEX 0, 0, 272, 148
STYLE DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    AUTORADIOBUTTON "", IDC_SET_MODE_TRIGGER, 10, 8, 252, 12, WS_GROUP | WS_TABSTOP
    LTEXT      "", IDC_SET_TRIG_LBL, 26, 26, 70, 10
    COMBOBOX   IDC_SET_TRIG, 100, 24, 154, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "", IDC_SET_MODE_AUTO, 10, 46, 252, 12, WS_GROUP | WS_TABSTOP
    LTEXT      "", IDC_SET_RULES_LBL, 26, 63, 236, 10
    AUTOCHECKBOX "", IDC_SET_RULE_O,  26, 76, 110, 12, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX "", IDC_SET_RULE_G, 144, 76, 110, 12, WS_TABSTOP
    AUTOCHECKBOX "", IDC_SET_RULE_SH, 26, 91, 110, 12, WS_TABSTOP
    AUTOCHECKBOX "", IDC_SET_RULE_CH,144, 91, 110, 12, WS_TABSTOP
    LTEXT      "", IDC_SET_EXAMPLE, 10, 114, 252, 28
END

// Tab "Tezkor tugmalar"
IDD_SET_HOTKEYS DIALOGEX 0, 0, 272, 148
STYLE DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    LTEXT      "", IDC_SET_HK_MODE_LBL,    10, 14, 118, 10
    CONTROL    "", IDC_SET_HK_MODE,    "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 132, 12, 122, 14
    LTEXT      "", IDC_SET_HK_ENABLE_LBL,  10, 38, 118, 10
    CONTROL    "", IDC_SET_HK_ENABLE,  "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 132, 36, 122, 14
    LTEXT      "", IDC_SET_HK_CONVERT_LBL, 10, 62, 118, 10
    CONTROL    "", IDC_SET_HK_CONVERT, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 132, 60, 122, 14
    LTEXT      "", IDC_SET_HK_HINT, 10, 88, 252, 44
END

// Tab "Istisnolar"
IDD_SET_EXCLUDE DIALOGEX 0, 0, 272, 148
STYLE DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    LTEXT      "", IDC_SET_EX_HINT, 10, 8, 252, 26
    LISTBOX    IDC_SET_EX_LIST, 10, 38, 164, 70,
               LBS_NOTIFY | LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "", IDC_SET_EX_REMOVE, 180, 38, 82, 14
    EDITTEXT   IDC_SET_EX_EDIT, 10, 116, 124, 14, ES_AUTOHSCROLL
    PUSHBUTTON "", IDC_SET_EX_ADD,    138, 116, 60, 14
    PUSHBUTTON "", IDC_SET_EX_BROWSE, 202, 116, 60, 14
END
// Dastur haqida dialogi
IDD_ABOUT DIALOGEX 0, 0, 260, 150
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 9, "Segoe UI"
BEGIN
    LTEXT      "", IDC_ABOUT_DESC,   14, 12, 232, 76
    LTEXT      "", IDC_ABOUT_DEV,    14, 92, 232, 12
    DEFPUSHBUTTON "", IDC_ABOUT_OPEN,    14, 120, 52, 18
    PUSHBUTTON "", IDC_ABOUT_GITHUB,     74, 120, 52, 18
    PUSHBUTTON "", IDC_ABOUT_LICENSE,   134, 120, 52, 18
    PUSHBUTTON "", IDCANCEL,            194, 120, 52, 18
END

// Litsenziya / ogohlantirish dialogi (matn ish vaqtida joriy tilda qo'yiladi)
IDD_LICENSE DIALOGEX 0, 0, 300, 190
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "License"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT   IDC_LIC_TEXT, 14, 12, 272, 140,
               ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "", IDOK,          120, 162, 76, 16
    PUSHBUTTON "", IDC_LIC_GITHUB,   210, 162, 76, 16
END
